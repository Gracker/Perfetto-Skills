  "id": "scene_reconstruction",
  "identity": {
    "aliases": [
      "package",
      "process_name",
      "package_name",
      "target_package",
      "app_package",
      "packageName",
      "processName"
    ],
    "minConfidence": 50,
    "policy": "verify_if_present",
    "rewriteTo": "recommended_process_name_param",
    "scope": "process"
  },
  "inputs": [
    {
      "name": "start_ts",
      "required": false,
      "type": "timestamp"
    },
    {
      "name": "end_ts",
      "required": false,
      "type": "timestamp"
    },
    {
      "name": "trace_id",
      "required": true,
      "type": "string"
    },
    {
      "default": 4096,
      "name": "scene_row_limit",
      "required": false,
      "type": "number"
    }
  ],
  "prerequisites": {
    "modules": [
      "android.input",
      "android.binder",
      "android.screen_state",
      "android.battery_stats",
      "android.startup.startups",
      "android.frames.timeline",
      "android.anrs"
    ],
    "required_tables": []
  },
  "query_id": null,
  "runtime_status": "executable",
