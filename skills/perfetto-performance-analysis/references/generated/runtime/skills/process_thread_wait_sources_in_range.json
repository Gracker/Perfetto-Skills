{
  "android": {
    "adapters": [
      {
        "id": "kernel_tracepoints",
        "selection": "available events, trace config/setup errors, schema, then rows"
      }
    ],
    "selection_order": [
      "device_capability",
      "trace_config_and_setup_errors",
      "engine_module_and_schema",
      "target_range_row_coverage",
      "api_hint"
    ],
    "signal_patterns": [
      "${package}",
      "${package}:*"
    ]
  },
  "id": "process_thread_wait_sources_in_range",
  "identity": {
    "aliases": [
      "package",
      "process_name"
    ],
    "policy": "verify_if_present",
    "scope": "process"
  },
  "inputs": [
    {
      "description": "目标进程名/包名",
      "name": "package",
      "required": true,
      "type": "string"
    },
    {
      "description": "分析起始时间戳(ns)",
      "name": "start_ts",
      "required": true,
      "type": "timestamp"
    },
    {
      "description": "分析结束时间戳(ns)",
      "name": "end_ts",
      "required": true,
      "type": "timestamp"
    },
    {
      "description": "可选：精确 upid，用于在同名多进程时消歧",
      "name": "upid",
      "required": false,
      "type": "number"
    },
    {
      "description": "可选：精确 pid，用于在同名多进程时消歧",
      "name": "pid",
      "required": false,
      "type": "number"
    },
    {
      "description": "汇总与明细的最大返回行数",
      "name": "top_k",
      "required": false,
      "type": "number"
    }
  ],
  "prerequisites": {
    "modules": [
      "android.network_packets"
    ],
    "required_tables": [
      "thread_state",
      "thread",
      "process"
    ]
  },
  "query_id": null,
