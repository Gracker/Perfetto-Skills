{
  "android": {
    "adapters": [
      {
        "id": "kernel_tracepoints",
        "selection": "available events, trace config/setup errors, schema, then rows"
      }
    ],
    "selection_order": [
      "device_capability",
      "trace_config_and_setup_errors",
      "engine_module_and_schema",
      "target_range_row_coverage",
      "api_hint"
    ],
    "signal_patterns": []
  },
  "id": "cpu_frequency_limit_episode",
  "identity": {
    "aliases": [
      "package",
      "process_name",
      "package_name",
      "target_package",
      "app_package",
      "packageName",
      "processName"
    ],
    "minConfidence": 50,
    "policy": "verify_if_present",
    "rewriteTo": "recommended_process_name_param",
    "scope": "process"
  },
  "inputs": [
    {
      "description": "区段标识（由上层传入）",
      "name": "episode_id",
      "required": false,
      "type": "string"
    },
    {
      "description": "全 trace 区段标识（policy%d-tep%d，由上层传入）；缺省时按 policy_cpu 与 episode_start_ts 定位",
      "name": "trace_episode_id",
      "required": false,
      "type": "string"
    },
    {
      "description": "限频起点时间戳(ns)：上层传入全 trace 区段的起点，不是窗口裁剪后的开始",
      "name": "episode_start_ts",
      "required": true,
      "type": "timestamp"
    },
    {
      "description": "区段结束时间戳(ns)",
      "name": "episode_end_ts",
      "required": true,
      "type": "timestamp"
    },
    {
      "description": "上层分析窗口起点(ns)；判定只使用在该窗口内生效的限频写入。缺省使用 episode_start_ts",
      "name": "window_start_ts",
      "required": false,
      "type": "timestamp"
    },
    {
      "description": "上层分析窗口终点(ns)；缺省使用 episode_end_ts",
      "name": "window_end_ts",
      "required": false,
      "type": "timestamp"
    },
    {
      "description": "cpufreq policy 首核编号",
      "name": "policy_cpu",
      "required": false,
      "type": "number"
    },
    {
      "description": "核心类型（可能为 unknown）",
      "name": "core_type",
      "required": false,
      "type": "string"
    },
    {
      "default": 10000,
      "description": "限频前回溯窗口长度(ms)",
      "name": "lookback_ms",
      "required": false,
      "type": "number"
    },
    {
      "default": 2000,
      "description": "限频时刻前后的归因窗口半径(ms)",
      "name": "who_window_ms",
      "required": false,
      "type": "number"
    },
    {
      "default": 50,
      "description": "散热设备档位变更与限频时刻的重合容差(ms)；重合才视为该次限频由内核热控直接施加",
      "name": "cooling_coincidence_ms",
      "required": false,
      "type": "number"
    },
    {
      "default": 10,
      "description": "判定限频区段的降幅阈值（相对本 trace 观测到的最大上限，%）；须与定位 trace_episode_id 的父级一致",
      "name": "episode_drop_pct",
      "required": false,
      "type": "number"
    },
    {
      "default": 500,
      "description": "限频区段合并间隔(ms)；须与定位 trace_episode_id 的父级一致",
      "name": "merge_gap_ms",
      "required": false,
      "type": "number"
    },
    {
      "default": 1,
      "description": "散热设备档位变更与其后 policy 上限变更的前向配对窗口(ms)",
      "name": "cdev_policy_pair_ms",
      "required": false,
      "type": "number"
    },
    {
      "default": 3,
      "description": "判定散热设备与 policy 关联所需的最少档位变更次数",
      "name": "cdev_policy_min_transitions",
      "required": false,
      "type": "number"
    },
    {
      "default": 80,
      "description": "判定关联所需的配对占比与同向占比下限(%)",
      "name": "cdev_policy_min_pair_pct",
      "required": false,
      "type": "number"
    },
    {
      "description": "目标包名/进程名",
      "name": "package",
      "required": false,
      "type": "string"
    },
    {
      "description": "目标进程名别名",
      "name": "process_name",
      "required": false,
      "type": "string"
    },
    {
      "default": 30,
      "description": "负载/异常线程返回上限",
      "name": "top_n",
      "required": false,
      "type": "number"
    },
    {
      "default": 80,
      "description": "异常线程：持续占用阈值(%)",
      "name": "sustained_pct",
      "required": false,
      "type": "number"
    },
    {
      "default": 200,
      "description": "异常线程：疑似空转平均片长上限(us)",
      "name": "spin_avg_slice_us",
      "required": false,
      "type": "number"
    },
    {
      "default": 2000,
      "description": "异常线程：疑似空转每秒片数下限",
      "name": "spin_switches_per_s",
      "required": false,
      "type": "number"
    },
    {
      "default": 500,
      "description": "异常线程：唤醒风暴阈值(次/秒)",
      "name": "waker_per_s",
      "required": false,
      "type": "number"
    },
    {
      "default": 10,
      "description": "异常线程：内核守护重载阈值(%)",
      "name": "kernel_daemon_share_pct",
      "required": false,
      "type": "number"
    }
  ],
  "prerequisites": {
    "modules": [
      "linux.cpu.frequency",
      "android.process_metadata"
    ],
    "required_tables": [
      "counter",
      "counter_track",
      "sched_slice"
    ]
  },
  "process_scope": {
    "role": "global_context"
  },
  "query_id": null,
  "runtime_status": "executable",
  "schema_version": 1,
  "source": {
    "path": "backend/skills/composite/cpu_frequency_limit_episode.skill.yaml",
    "sha256": "8d75cefe0155fc514370fc541fbd0b54aa5c81c152e666ea0dde0514011da4cb"
  },
  "steps": [
    {
      "displayed": true,
      "id": "episode_windows",
      "name": "区段分析窗口",
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "cpu_frequency_limit_episode/episode_windows",
      "result_dependencies": [],
      "save_as": "episode_windows",
      "type": "atomic"
    },
    {
      "displayed": true,
      "id": "who_cooling",
      "name": "归因窗口内散热设备活动",
      "on_empty": "归因窗口内没有内核散热设备事件。该平台可能没有 cdev_update，或热控由用户态守护进程直接写 sysfs 完成。",
      "optional": true,
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "cpu_frequency_limit_episode/who_cooling",
      "result_dependencies": [],
      "save_as": "who_cooling",
      "type": "atomic"
    },
    {
      "displayed": true,
      "id": "who_daemon",
      "name": "归因窗口内温控/性能策略守护进程活动",
      "on_empty": "归因窗口内没有名字匹配温控/性能策略签名的线程在运行。",
      "optional": true,
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "cpu_frequency_limit_episode/who_daemon",
      "result_dependencies": [],
      "save_as": "who_daemon",
      "type": "atomic"
    },
    {
      "displayed": true,
      "id": "temperature_context",
      "name": "区段起点前温度上下文",
      "on_empty": "回溯窗口内没有温度采样。部分平台温度上报非常稀疏（每分钟数次），窗口内无样本不代表温度未变化。",
      "optional": true,
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "cpu_frequency_limit_episode/temperature_context",
      "result_dependencies": [],
      "save_as": "temperature_context",
      "type": "atomic"
    },
    {
      "displayed": true,
      "id": "before_workload",
      "name": "区段起点前负载归因",
      "optional": true,
      "params": {
        "end_ts": "${episode_windows.data?.[0]?.before_end_ts}",
        "package": "${package || ''}",
        "process_name": "${process_name || ''}",
        "start_ts": "${episode_windows.data?.[0]?.before_start_ts}",
        "top_n": "${top_n|30}"
      },
      "save_as": "before_workload",
      "skill": "cpu_workload_attribution_in_range",
      "type": "skill"
    },
    {
      "displayed": true,
      "id": "before_anomalies",
      "name": "区段起点前异常线程",
      "optional": true,
      "params": {
        "end_ts": "${episode_windows.data?.[0]?.before_end_ts}",
        "kernel_daemon_share_pct": "${kernel_daemon_share_pct|10}",
        "package": "${package || ''}",
        "process_name": "${process_name || ''}",
        "spin_avg_slice_us": "${spin_avg_slice_us|200}",
        "spin_switches_per_s": "${spin_switches_per_s|2000}",
        "start_ts": "${episode_windows.data?.[0]?.before_start_ts}",
        "sustained_pct": "${sustained_pct|80}",
        "top_n": "${top_n|30}",
        "waker_per_s": "${waker_per_s|500}"
      },
      "save_as": "before_anomalies",
      "skill": "cpu_anomalous_threads_in_range",
      "type": "skill"
    },
    {
      "displayed": true,
      "id": "non_cpu_heat_context",
      "name": "区段起点前非 CPU 热源上下文",
      "on_empty": "回溯窗口内没有观测到非 CPU 热源相关的计数器或进程活动。",
      "optional": true,
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "cpu_frequency_limit_episode/non_cpu_heat_context",
      "result_dependencies": [],
      "save_as": "non_cpu_heat_context",
      "type": "atomic"
    },
    {
      "displayed": true,
      "id": "who_verdict",
      "name": "触发方判定",
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "cpu_frequency_limit_episode/who_verdict",
      "result_dependencies": [],
      "save_as": "who_verdict",
      "type": "atomic"
    },
    {
      "condition": "who_verdict.data?.length > 0",
      "displayed": true,
      "id": "limit_onsets",
      "name": "逐次限频写入判定",
      "on_empty": "该区段在分析窗口内没有可判定的限频写入。",
      "optional": true,
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "cpu_frequency_limit_episode/limit_onsets",
      "result_dependencies": [
        "who_verdict"
      ],
      "save_as": "limit_onsets",
      "type": "atomic"
    }
  ],
  "type": "composite",
  "version": "1.0",
  "workflow": "power-thermal"
}
