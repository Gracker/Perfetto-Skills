{
  "android": {
    "adapters": [
      {
        "id": "kernel_tracepoints",
        "selection": "available events, trace config/setup errors, schema, then rows"
      }
    ],
    "selection_order": [
      "device_capability",
      "trace_config_and_setup_errors",
      "engine_module_and_schema",
      "target_range_row_coverage",
      "api_hint"
    ],
    "signal_patterns": []
  },
  "id": "thermal_cooling_device_timeline",
  "identity": {
    "policy": "none"
  },
  "inputs": [
    {
      "description": "分析起始时间戳(ns)；缺省使用观测数据起点",
      "name": "start_ts",
      "required": false,
      "type": "timestamp"
    },
    {
      "description": "分析结束时间戳(ns)；缺省使用 trace 数据终点",
      "name": "end_ts",
      "required": false,
      "type": "timestamp"
    },
    {
      "default": 200,
      "description": "返回的状态转换行数上限",
      "name": "max_transitions",
      "required": false,
      "type": "number"
    }
  ],
  "prerequisites": {
    "modules": [
      "linux.cpu.frequency"
    ],
    "required_tables": [
      "counter_track",
      "counter"
    ]
  },
  "process_scope": {
    "role": "global_context"
  },
  "query_id": null,
  "runtime_status": "executable",
  "schema_version": 1,
  "source": {
    "commit": "d00e17d1ea0f0fe6fea8fe9981d173169cc6c9c5",
    "path": "backend/skills/atomic/thermal_cooling_device_timeline.skill.yaml",
    "sha256": "212c1203887256c5706a1e12c54ae6d163c0bb8647edd88afb0f73cc624cf16f"
  },
  "steps": [
    {
      "id": "cooling_data_check",
      "name": "散热设备数据检测",
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "thermal_cooling_device_timeline/cooling_data_check",
      "result_dependencies": [],
      "save_as": "cooling_data_check",
      "type": "atomic"
    },
    {
      "condition": "cooling_data_check.data?.[0]?.has_cdev_data === 1",
      "id": "cooling_summary",
      "name": "散热设备概览",
      "optional": true,
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "thermal_cooling_device_timeline/cooling_summary",
      "result_dependencies": [],
      "save_as": "cooling_summary",
      "type": "atomic"
    },
    {
      "condition": "cooling_data_check.data?.[0]?.has_cdev_data === 1",
      "id": "cooling_transitions",
      "name": "散热设备状态转换",
      "on_empty": "窗口内没有散热设备状态转换。",
      "optional": true,
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "thermal_cooling_device_timeline/cooling_transitions",
      "result_dependencies": [],
      "save_as": "cooling_transitions",
      "type": "atomic"
    },
    {
      "condition": "cooling_data_check.data?.[0]?.has_cdev_data !== 1",
      "id": "cooling_unavailable",
      "name": "无散热设备数据",
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "thermal_cooling_device_timeline/cooling_unavailable",
      "result_dependencies": [],
      "save_as": "cooling_unavailable",
      "type": "atomic"
    }
  ],
  "type": "atomic",
  "version": "1.0",
  "workflow": "power-thermal"
}
