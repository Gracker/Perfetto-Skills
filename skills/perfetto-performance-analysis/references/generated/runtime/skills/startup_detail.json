{
  "android": {
    "adapters": [
      {
        "branches": [
          "api<=28",
          "api29-32",
          "api>=33"
        ],
        "id": "official_android_startup_tags",
        "source": "perfetto stdlib android/startup/startups.sql"
      },
      {
        "id": "kernel_tracepoints",
        "selection": "available events, trace config/setup errors, schema, then rows"
      }
    ],
    "selection_order": [
      "device_capability",
      "trace_config_and_setup_errors",
      "engine_module_and_schema",
      "target_range_row_coverage",
      "api_hint"
    ],
    "signal_patterns": [
      "${package}",
      "${package}:*"
    ]
  },
  "id": "startup_detail",
  "identity": {
    "aliases": [
      "package",
      "process_name"
    ],
    "policy": "required",
    "rewriteTo": "recommended_process_name_param",
    "scope": "process"
  },
  "inputs": [
    {
      "description": "启动事件 ID",
      "name": "startup_id",
      "required": true,
      "type": "integer"
    },
    {
      "description": "启动开始时间戳(ns)",
      "name": "start_ts",
      "required": true,
      "type": "timestamp"
    },
    {
      "description": "启动结束时间戳(ns)",
      "name": "end_ts",
      "required": true,
      "type": "timestamp"
    },
    {
      "description": "启动耗时(ms)",
      "name": "dur_ms",
      "required": true,
      "type": "number"
    },
    {
      "description": "应用包名",
      "name": "package",
      "required": true,
      "type": "string"
    },
    {
      "description": "启动类型 (cold/warm/hot)，已经过 bindApplication 存在性校验",
      "name": "startup_type",
      "required": true,
      "type": "string"
    },
    {
      "description": "Perfetto 原始报告的启动类型（校验前）",
      "name": "original_type",
      "required": false,
      "type": "string"
    },
    {
      "description": "TTID (ms)",
      "name": "ttid_ms",
      "required": false,
      "type": "number"
    },
    {
      "description": "TTFD (ms)",
      "name": "ttfd_ms",
      "required": false,
      "type": "number"
    },
    {
      "description": "Perfetto 跳转开始时间",
      "name": "perfetto_start",
      "required": false,
      "type": "timestamp"
    },
    {
      "description": "Perfetto 跳转结束时间",
      "name": "perfetto_end",
      "required": false,
      "type": "timestamp"
    }
  ],
  "prerequisites": {
    "modules": [
      "android.startup.startups",
      "android.binder",
      "linux.cpu.frequency"
    ],
    "required_tables": [
      "android_startups"
    ]
  },
  "query_id": null,
  "runtime_status": "executable",
  "schema_version": 1,
  "source": {
    "commit": "d00e17d1ea0f0fe6fea8fe9981d173169cc6c9c5",
    "path": "backend/skills/composite/startup_detail.skill.yaml",
    "sha256": "33481081237e74c06b4dc8d1d96123519db58062a3214483d83a5ab46c43d287"
  },
  "steps": [
    {
      "id": "init_cpu_topology",
      "name": "初始化 CPU 拓扑",
      "optional": true,
      "skill": "cpu_topology_view",
      "type": "skill"
    },
    {
      "id": "startup_info",
      "name": "启动基本信息",
      "query_id": "startup_detail/startup_info",
      "result_dependencies": [],
      "save_as": "startup_basic",
      "type": "atomic"
    },
    {
      "id": "cpu_core_analysis",
      "name": "大小核占比分析",
      "process_scope": {
        "binding": "effective_target_processes",
        "role": "target"
      },
      "query_id": "startup_detail/cpu_core_analysis",
      "result_dependencies": [],
      "save_as": "cpu_core",
      "type": "atomic"
    },
    {
      "id": "cpu_freq_analysis",
      "name": "CPU 频率分析",
      "process_scope": {
        "binding": "effective_target_processes",
        "role": "target"
      },
      "query_id": "startup_detail/cpu_freq_analysis",
      "result_dependencies": [],
      "save_as": "cpu_freq",
      "type": "atomic"
    },
    {
      "id": "per_cpu_system_context",
      "name": "逐核频率与系统负载上下文",
      "optional": true,
      "process_scope": {
        "binding": "effective_target_processes",
        "context_fields": {
          "global_context": [
            "cpu",
            "ucpu",
            "machine_id",
            "capacity",
            "cluster_id",
            "core_type",
            "topology_source",
            "avg_freq_mhz",
            "min_freq_mhz",
            "max_freq_mhz",
            "freq_coverage_ms",
            "freq_coverage_pct",
            "frequency_evidence",
            "system_busy_ms",
            "system_busy_pct",
            "sched_coverage_ms",
            "idle_ns",
            "idle_identity_unknown_ns",
            "sched_evidence"
          ]
        },
        "role": "target"
      },
      "query_id": "startup_detail/per_cpu_system_context",
      "result_dependencies": [],
      "save_as": "per_cpu_context",
      "type": "atomic"
    },
    {
      "id": "preemption",
      "name": "目标线程抢占切换证据",
      "optional": true,
      "process_scope": {
        "binding": "effective_target_processes",
        "context_fields": {
          "peer_context": [
            "next_sched_id",
            "next_utid",
            "next_tid",
            "next_upid",
            "next_pid",
            "next_thread_name",
            "next_process_name",
            "next_priority",
            "next_is_idle",
            "next_role"
          ]
        },
        "role": "target"
      },
      "query_id": "startup_detail/preemption",
      "result_dependencies": [],
      "save_as": "preemption_handoffs",
      "type": "atomic"
    },
    {
      "id": "freq_rampup",
      "name": "CPU 频率阶段对比",
      "optional": true,
      "params": {
        "end_ts": "${end_ts}",
        "start_ts": "${start_ts}"
      },
      "save_as": "freq_rampup",
      "skill": "startup_freq_rampup",
      "type": "skill"
    },
    {
      "id": "quadrant_analysis",
      "name": "四大象限分析",
      "optional": true,
      "process_scope": {
        "binding": "effective_target_processes",
        "role": "target"
      },
      "query_id": "startup_detail/quadrant_analysis",
      "result_dependencies": [],
      "save_as": "quadrant",
      "type": "atomic"
    },
    {
      "id": "cpu_placement_timeline",
      "name": "摆核时序分析",
      "optional": true,
      "params": {
        "bucket_ms": 50,
        "end_ts": "${end_ts}",
        "package": "${package}",
        "start_ts": "${start_ts}"
      },
      "save_as": "cpu_placement",
      "skill": "startup_cpu_placement_timeline",
      "type": "skill"
    },
    {
      "id": "main_thread_slices",
      "name": "主线程耗时操作",
      "params": {
        "end_ts": "${end_ts}",
        "min_dur_ns": 1000000,
        "package": "${package}",
        "start_ts": "${start_ts}",
        "top_k": 10
      },
      "save_as": "main_slices",
      "skill": "main_thread_slices_in_range",
      "type": "skill"
    },
    {
      "id": "actionable_main_thread_slices",
      "name": "主线程可操作热点",
      "query_id": "startup_detail/actionable_main_thread_slices",
      "result_dependencies": [],
      "save_as": "actionable_main_slices",
      "type": "atomic"
    },
    {
      "id": "main_thread_file_io",
      "name": "主线程文件 IO",
      "params": {
        "end_ts": "${end_ts}",
        "min_dur_ns": 500000,
        "package": "${package}",
        "start_ts": "${start_ts}",
        "top_k": 10
      },
      "save_as": "main_file_io",
      "skill": "main_thread_file_io_in_range",
      "type": "skill"
    },
    {
      "id": "binder_analysis",
      "name": "Binder 调用分析",
      "params": {
        "end_ts": "${end_ts}",
        "package": "${package}",
        "start_ts": "${start_ts}"
      },
      "save_as": "binder_calls",
      "skill": "binder_in_range",
      "type": "skill"
    },
    {
      "id": "main_thread_sync_binder",
      "name": "主线程同步 Binder",
      "params": {
        "end_ts": "${end_ts}",
        "package": "${package}",
        "start_ts": "${start_ts}"
      },
      "save_as": "main_sync_binder",
      "skill": "binder_blocking_in_range",
      "type": "skill"
    },
    {
      "id": "binder_pool",
      "name": "Binder 线程池分析",
      "optional": true,
      "params": {
        "end_ts": "${end_ts}",
        "package": "${package}",
        "start_ts": "${start_ts}"
      },
      "save_as": "binder_pool",
      "skill": "startup_binder_pool_analysis",
      "type": "skill"
    },
    {
      "id": "sched_latency",
      "name": "调度延迟分析",
      "params": {
        "end_ts": "${end_ts}",
        "package": "${package}",
        "start_ts": "${start_ts}"
      },
      "save_as": "sched_delay",
      "skill": "main_thread_sched_latency_in_range",
      "type": "skill"
    },
    {
      "id": "main_thread_state",
      "name": "主线程状态分布",
      "params": {
        "end_ts": "${end_ts}",
        "package": "${package}",
        "start_ts": "${start_ts}",
        "startup_id": "${startup_id}",
        "startup_type": "${startup_type}"
      },
      "save_as": "thread_states",
      "skill": "startup_main_thread_states_in_range",
      "type": "skill"
    },
    {
      "id": "critical_tasks",
      "name": "启动关键任务",
      "optional": true,
      "params": {
        "end_ts": "${end_ts}",
        "package": "${package}",
        "start_ts": "${start_ts}",
        "top_k": 15
      },
      "save_as": "critical_tasks",
      "skill": "startup_critical_tasks",
      "type": "skill"
    },
    {
      "id": "critical_task_system_evidence",
      "name": "关键任务系统证据与覆盖",
      "optional": true,
      "params": {
        "end_ts": "${end_ts}",
        "package": "${package}",
        "start_ts": "${start_ts}"
      },
      "save_as": "critical_task_system_evidence",
      "skill": "thread_system_summary_in_range",
      "type": "skill"
    },
    {
      "id": "thread_blocking_graph",
      "name": "线程阻塞关系",
      "optional": true,
      "params": {
        "end_ts": "${end_ts}",
        "min_block_ms": 1,
        "package": "${package}",
        "start_ts": "${start_ts}",
        "top_k": 20
      },
      "save_as": "blocking_graph",
      "skill": "startup_thread_blocking_graph",
      "type": "skill"
    },
    {
      "condition": "'${startup_type}' === 'cold'",
      "id": "jit_analysis",
      "name": "JIT 影响分析",
      "optional": true,
      "params": {
        "end_ts": "${end_ts}",
        "package": "${package}",
        "start_ts": "${start_ts}"
      },
      "save_as": "jit_analysis",
      "skill": "startup_jit_analysis",
      "type": "skill"
    },
    {
      "id": "hot_slice_states",
      "name": "热点 Slice 线程状态",
      "optional": true,
      "params": {
        "end_ts": "${end_ts}",
        "package": "${package}",
        "start_ts": "${start_ts}",
        "top_n": 10
      },
      "save_as": "hot_slice_states",
      "skill": "startup_hot_slice_states",
      "type": "skill"
    },
    {
      "id": "startup_diagnosis",
      "inputs": [
        "startup_basic",
        "cpu_core",
        "cpu_freq",
        "per_cpu_context",
        "preemption_handoffs",
        "freq_rampup",
        "quadrant",
        "cpu_placement",
        "main_slices",
        "actionable_main_slices",
        "main_file_io",
        "binder_calls",
        "main_sync_binder",
        "binder_pool",
        "sched_delay",
        "thread_states",
        "critical_tasks",
        "blocking_graph",
        "jit_analysis",
        "hot_slice_states"
      ],
      "name": "启动诊断",
      "rules": [
        {
          "condition": "cpu_core.data[0]?.big_core_pct < 20 && cpu_core.data[0]?.unknown_core_pct === 0 && quadrant.data[0]?.q3_runnable_ms > 50",
          "confidence": "medium",
          "diagnosis": "主线程大核占比偏低（${cpu_core.data[0].big_core_pct}%）且 Runnable 排队明显（${quadrant.data[0].q3_runnable_ms}ms），可能存在调度供给不足",
          "severity": "warning",
          "suggestions": [
            "检查是否有其他高优先级进程抢占大核",
            "对照关键线程 kernel priority、R+ 切换和 affinity/cgroup 证据，再评估调度配置"
          ]
        },
        {
          "condition": "cpu_core.data[0]?.unknown_core_pct > 0",
          "confidence": "medium",
          "diagnosis": "主线程运行时间中 ${cpu_core.data[0].unknown_core_pct}% 的核类型未知，不能把未知部分计为小核或据此认定摆核不足",
          "severity": "info",
          "suggestions": [
            "补充或检查 cpu_frequency/cpu capacity 数据后再判断大小核调度问题"
          ]
        },
        {
          "condition": "quadrant.data[0]?.q3_runnable_ms > 50 && (sched_delay.data[0]?.severe_count || 0) > 3",
          "confidence": "high",
          "diagnosis": "主线程 Runnable 等待 ${quadrant.data[0].q3_runnable_ms}ms，且存在 ${sched_delay.data[0].severe_count} 次 >8ms 调度延迟",
          "severity": "warning",
          "suggestions": [
            "对照等待区间内的 CPU 交接、系统负载和目标线程可运行范围，确认是否存在资源竞争",
            "减少启动期间的并发线程数"
          ]
        },
        {
          "condition": "quadrant.data[0]?.q4a_pct > 15 && ((main_file_io.data[0]?.percent || 0) > 2 || thread_states?.data?.find(r => (r.evidence_strength === 'direct_io_wait' || r.evidence_strength === 'inferred_io_or_page_cache') && ((r.percent || 0) > 5)))",
          "confidence": "medium",
          "diagnosis": "主线程不可中断等待占比 ${quadrant.data[0].q4a_pct}%，并出现文件 I/O 或 io_wait/page-cache blocked_function 证据，属于 IO/page-cache 等待候选",
          "severity": "warning",
          "suggestions": [
            "将数据库/文件读写操作移至后台线程",
            "使用异步 IO 或延迟加载策略",
            "检查 APK/DEX 文件读取是否在关键路径"
          ]
        },
        {
          "condition": "quadrant.data[0]?.q4b_pct > 30 && ((main_sync_binder?.data?.find(r => r.is_main_blocked === 1)?.total_block_ms) || 0) > 20",
          "confidence": "medium",
          "diagnosis": "主线程睡眠等待(S 状态) 占比 ${quadrant.data[0].q4b_pct}% 且存在 Binder 阻塞证据",
          "severity": "warning",
          "suggestions": [
            "检查主线程同步 Binder 调用，改为异步",
            "减少启动期间的锁竞争"
          ]
        },
        {
          "condition": "(main_file_io.data[0]?.total_ms > 50 || main_file_io.data[0]?.percent > 5) && ((quadrant.data[0]?.q4a_pct || 0) > 10 || (quadrant.data[0]?.q4b_pct || 0) > 20)",
          "confidence": "high",
          "diagnosis": "主线程文件 IO '${main_file_io.data[0].io_slice}' 耗时 ${main_file_io.data[0].total_ms}ms（占比 ${main_file_io.data[0].percent}%）",
          "severity": "warning",
          "suggestions": [
            "避免在首帧前执行文件读取/写入，改为预取或延迟加载",
            "数据库初始化改为异步，合并小 IO 为批量 IO"
          ]
        },
        {
          "condition": "(((main_sync_binder?.data?.find(r => r.is_main_blocked === 1)?.total_block_ms) || 0) > 80 || ((main_sync_binder?.data?.find(r => r.is_main_blocked === 1)?.max_block_ms) || 0) > 16) && ((quadrant.data[0]?.q4b_pct || 0) > 15 || (quadrant.data[0]?.q3_runnable_ms || 0) > 20)",
          "confidence": "high",
          "diagnosis": "主线程同步 Binder '${main_sync_binder.data.find(r => r.is_main_blocked === 1)?.interface}' 阻塞 ${main_sync_binder.data.find(r => r.is_main_blocked === 1)?.total_block_ms}ms",
          "severity": "warning",
          "suggestions": [
            "将同步 Binder 改为异步或迁移到后台线程",
            "减少启动首屏前的跨进程依赖调用"
          ]
        },
        {
          "condition": "binder_calls.data[0]?.total_client_ms > 100 && ((main_sync_binder?.data?.find(r => r.is_main_blocked === 1)?.total_block_ms) || 0) > 20",
          "confidence": "high",
          "diagnosis": "Binder 调用 ${binder_calls.data[0].server_process} 总耗时 ${binder_calls.data[0].total_client_ms}ms，且主线程存在同步 Binder 阻塞",
          "severity": "warning",
          "suggestions": [
            "减少启动期间的 IPC 调用",
            "使用异步 Binder 或延迟调用"
          ]
        },
        {
          "condition": "(sched_delay.data[0]?.severe_count || 0) > 5 && (sched_delay.data[0]?.max_latency_ms || 0) > 8",
          "confidence": "medium",
          "diagnosis": "存在 ${sched_delay.data[0].severe_count} 次严重调度延迟 (>8ms)，最大延迟 ${sched_delay.data[0].max_latency_ms}ms",
          "severity": "warning",
          "suggestions": [
            "检查系统负载，减少后台进程",
            "核对抢占交接、线程 kernel priority 与实际调度策略；缺少策略证据时保留未知，不能仅凭等待总量建议改为 RT"
          ]
        },
        {
          "condition": "((actionable_main_slices.data[0]?.is_framework_wrapper || 0) === 0) && (actionable_main_slices.data[0]?.max_ms || 0) > 80 && (actionable_main_slices.data[0]?.percent || 0) > 15",
          "confidence": "high",
          "diagnosis": "主线程可操作热点 '${actionable_main_slices.data[0].slice_name}' 最长耗时 ${actionable_main_slices.data[0].max_ms}ms（占比 ${actionable_main_slices.data[0].percent}%）",
          "severity": "warning",
          "suggestions": [
            "优先下钻该切片内部子阶段，定位可迁移到后台的初始化任务",
            "将首帧前非关键任务延后到 TTID 之后执行"
          ]
        },
        {
          "condition": "main_slices.data[0]?.max_ms > 100 && (main_slices.data[0]?.percent || 0) > 20 && !['clientTransactionExecuted', 'activityStart', 'bindApplication'].includes(main_slices.data[0]?.slice_name || '') && !(main_slices.data[0]?.slice_name || '').startsWith('performCreate:')",
          "confidence": "high",
          "diagnosis": "主线程操作 '${main_slices.data[0].slice_name}' 最长耗时 ${main_slices.data[0].max_ms}ms",
          "severity": "warning",
          "suggestions": [
            "优化该操作或移到后台线程",
            "检查是否可以分批执行"
          ]
        },
        {
          "condition": "(quadrant.data[0]?.q4b_pct || 0) > 25 && thread_states?.data?.find(r => r.state === 'S')?.percent > 20 && (thread_states?.data?.find(r => r.state === 'S')?.blocked_functions || '').includes('futex')",
          "confidence": "medium",
          "diagnosis": "主线程 S(Sleeping) 状态占比 ${thread_states.data.find(r => r.state === 'S').percent}%，blocked_functions 含 futex 相关函数，存在 futex 路径等待；尚不能区分锁竞争、条件变量或线程 join",
          "severity": "warning",
          "suggestions": [
            "关联锁对象/持有者、竞争事件或对应调用栈，区分 mutex、条件变量和 join",
            "仅对确认影响关键路径的同步依赖提出修改"
          ]
        },
        {
          "condition": "(quadrant.data[0]?.q4a_pct || 0) > 10 && thread_states?.data?.find(r => (r.evidence_strength === 'direct_io_wait' || r.evidence_strength === 'inferred_io_or_page_cache') && ((r.percent || 0) > 5))",
          "confidence": "medium",
          "diagnosis": "主线程 D/不可中断等待中出现 IO/page-cache 证据（${thread_states.data.find(r => r.evidence_strength === 'direct_io_wait' || r.evidence_strength === 'inferred_io_or_page_cache').total_dur_ms}ms），需要结合文件/DB slice 或 block I/O 进一步定因",
          "severity": "warning",
          "suggestions": [
            "将数据库/文件操作移至后台线程",
            "使用异步 IO 或延迟加载"
          ]
        },
        {
          "condition": "(critical_tasks?.data?.find(t => t.role === 'jit')?.total_cpu_ms || 0) > 20 && (critical_tasks?.data?.find(t => t.role === 'jit')?.big_core_pct || 0) > 50",
          "confidence": "medium",
          "diagnosis": "JIT 线程 CPU 时间 ${critical_tasks.data.find(t => t.role === 'jit').total_cpu_ms}ms（已分类大核占比 ${critical_tasks.data.find(t => t.role === 'jit').big_core_pct}%）；这是后台执行量，是否竞争需对齐主线程 Runnable 与同 CPU 区间",
          "severity": "warning",
          "suggestions": [
