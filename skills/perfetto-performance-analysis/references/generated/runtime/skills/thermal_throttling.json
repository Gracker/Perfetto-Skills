{
  "android": {
    "adapters": [
      {
        "id": "kernel_tracepoints",
        "selection": "available events, trace config/setup errors, schema, then rows"
      }
    ],
    "selection_order": [
      "device_capability",
      "trace_config_and_setup_errors",
      "engine_module_and_schema",
      "target_range_row_coverage",
      "api_hint"
    ],
    "signal_patterns": [
      "%gpu%",
      "%temp%",
      "%temperature%",
      "%thermal%",
      "%tsens%",
      "cpufreq"
    ]
  },
  "id": "thermal_throttling",
  "identity": {
    "aliases": [
      "package",
      "process_name",
      "package_name",
      "target_package",
      "app_package",
      "packageName",
      "processName"
    ],
    "minConfidence": 50,
    "policy": "verify_if_present",
    "rewriteTo": "recommended_process_name_param",
    "scope": "process"
  },
  "inputs": [
    {
      "description": "应用包名（可选）",
      "name": "package",
      "required": false,
      "type": "string"
    },
    {
      "description": "分析起始时间戳（纳秒，可选）",
      "name": "start_ts",
      "required": false,
      "type": "timestamp"
    },
    {
      "description": "分析结束时间戳（纳秒，可选）",
      "name": "end_ts",
      "required": false,
      "type": "timestamp"
    },
    {
      "default": true,
      "description": "是否启用专家探针（热预测/GPU DVFS）",
      "name": "enable_expert_probes",
      "required": false,
      "type": "boolean"
    },
    {
      "default": 30,
      "description": "热预测高风险的平均降频阈值（%）",
      "name": "thermal_predictor_high_drop_pct",
      "required": false,
      "type": "number"
    },
    {
      "default": 15,
      "description": "热预测中风险的平均降频阈值（%）",
      "name": "thermal_predictor_medium_drop_pct",
      "required": false,
      "type": "number"
    },
    {
      "default": 50,
      "description": "热预测高风险的限频核心占比阈值（%）",
      "name": "thermal_predictor_high_core_ratio_pct",
      "required": false,
      "type": "number"
    },
    {
      "default": 25,
      "description": "热预测中风险的限频核心占比阈值（%）",
      "name": "thermal_predictor_medium_core_ratio_pct",
      "required": false,
      "type": "number"
    },
    {
      "default": 30,
      "description": "判定单核心疑似限频的降频阈值（%）",
      "name": "thermal_predictor_core_drop_threshold_pct",
      "required": false,
      "type": "number"
    },
    {
      "default": 12,
      "description": "GPU 升降频判定阈值（%）",
      "name": "gpu_transition_threshold_pct",
      "required": false,
      "type": "number"
    },
    {
      "default": 25,
      "description": "GPU 降频占比告警阈值（%）",
      "name": "gpu_downshift_warning_pct",
      "required": false,
      "type": "number"
    }
  ],
  "prerequisites": {
    "modules": [],
    "required_tables": [
      "counter"
    ]
  },
  "query_id": null,
  "runtime_status": "executable",
  "schema_version": 1,
  "source": {
    "path": "backend/skills/composite/thermal_throttling.skill.yaml",
    "sha256": "03d5214cde82b7f701aaf49433f9e9dd86053d0c50cd7845247da2506662c32e"
  },
  "steps": [
    {
      "id": "data_check",
      "name": "温度数据检测",
      "query_id": "thermal_throttling/data_check",
      "result_dependencies": [],
      "save_as": "data_check",
      "type": "atomic"
    },
    {
      "condition": "enable_expert_probes !== false && (data_check.data[0]?.has_thermal_data === 1 || data_check.data[0]?.has_freq_data === 1 || data_check.data[0]?.has_gpu_freq_data === 1)",
      "id": "expert_analysis_window",
      "name": "热分析窗口",
      "optional": true,
      "query_id": "thermal_throttling/expert_analysis_window",
      "result_dependencies": [],
      "save_as": "analysis_window",
      "type": "atomic"
    },
    {
      "condition": "enable_expert_probes !== false && data_check.data[0]?.has_freq_data === 1 && analysis_window.data?.[0]?.window_start_ts != null && analysis_window.data?.[0]?.window_end_ts != null",
      "displayed": true,
      "id": "thermal_predictor_probe",
      "name": "CPU 频率趋势",
      "optional": true,
      "params": {
        "core_drop_threshold_pct": "${thermal_predictor_core_drop_threshold_pct|30}",
        "end_ts": "${analysis_window.data?.[0]?.window_end_ts ?? end_ts ?? null}",
        "high_core_ratio_threshold_pct": "${thermal_predictor_high_core_ratio_pct|50}",
        "high_drop_threshold_pct": "${thermal_predictor_high_drop_pct|30}",
        "medium_core_ratio_threshold_pct": "${thermal_predictor_medium_core_ratio_pct|25}",
        "medium_drop_threshold_pct": "${thermal_predictor_medium_drop_pct|15}",
        "start_ts": "${analysis_window.data?.[0]?.window_start_ts ?? start_ts ?? null}"
      },
      "save_as": "thermal_prediction",
      "skill": "thermal_predictor",
      "type": "skill"
    },
    {
      "condition": "data_check.data?.[0]?.has_max_limit_data === 1",
      "displayed": true,
      "id": "direct_limit_evidence",
      "name": "直接限频证据",
      "on_empty": "窗口内没有超过阈值的限频区段。",
      "optional": true,
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "thermal_throttling/direct_limit_evidence",
      "result_dependencies": [],
      "save_as": "direct_limit_evidence",
      "type": "atomic"
    },
    {
      "condition": "data_check.data[0]?.has_thermal_data === 1",
      "displayed": true,
      "id": "thermal_overview",
      "name": "温度传感器概览",
      "optional": true,
      "query_id": "thermal_throttling/thermal_overview",
      "result_dependencies": [],
      "save_as": "thermal_overview",
      "type": "atomic"
    },
    {
      "condition": "data_check.data[0]?.has_freq_data === 1",
      "displayed": true,
      "id": "cpu_freq_overview",
      "name": "CPU 频率概览",
      "optional": true,
      "query_id": "thermal_throttling/cpu_freq_overview",
      "result_dependencies": [],
      "save_as": "cpu_freq_overview",
      "type": "atomic"
    },
    {
      "condition": "enable_expert_probes !== false && data_check.data[0]?.has_gpu_freq_data === 1 && analysis_window.data?.[0]?.window_start_ts != null && analysis_window.data?.[0]?.window_end_ts != null",
      "displayed": true,
      "id": "gpu_power_probe",
      "name": "GPU DVFS 探针",
      "optional": true,
      "params": {
        "end_ts": "${analysis_window.data?.[0]?.window_end_ts ?? end_ts ?? null}",
        "start_ts": "${analysis_window.data?.[0]?.window_start_ts ?? start_ts ?? null}",
        "transition_threshold_pct": "${gpu_transition_threshold_pct|12}"
      },
      "save_as": "gpu_power_probe",
      "skill": "gpu_power_state_analysis",
      "type": "skill"
    },
    {
      "condition": "data_check.data[0]?.has_thermal_data === 1",
      "displayed": true,
      "id": "thermal_timeline",
      "name": "温度变化时间线",
      "optional": true,
      "query_id": "thermal_throttling/thermal_timeline",
      "result_dependencies": [],
      "save_as": "thermal_timeline",
      "type": "atomic"
    },
    {
      "condition": "data_check.data[0]?.has_freq_data === 1",
      "displayed": true,
      "id": "frequency_drop_events",
      "name": "频率骤降事件",
      "optional": true,
      "query_id": "thermal_throttling/frequency_drop_events",
      "result_dependencies": [],
      "save_as": "frequency_drops",
      "type": "atomic"
    },
    {
      "condition": "data_check.data[0]?.has_thermal_data === 1 && data_check.data[0]?.has_freq_data === 1",
      "displayed": true,
      "id": "thermal_freq_correlation",
      "name": "温度-频率相关性",
      "optional": true,
      "query_id": "thermal_throttling/thermal_freq_correlation",
      "result_dependencies": [],
      "save_as": "thermal_freq_correlation",
      "type": "atomic"
    },
    {
      "condition": "data_check.data[0]?.has_thermal_data === 1",
      "displayed": true,
      "id": "high_temp_periods",
      "name": "高温时段",
      "optional": true,
      "query_id": "thermal_throttling/high_temp_periods",
      "result_dependencies": [],
      "save_as": "high_temp_periods",
      "type": "atomic"
    },
    {
      "condition": "data_check.data[0]?.has_thermal_data === 1 || data_check.data[0]?.has_freq_data === 1",
      "displayed": true,
      "id": "root_cause_classification",
      "name": "根因分类",
      "query_id": "thermal_throttling/root_cause_classification",
      "result_dependencies": [],
      "save_as": "root_cause",
      "type": "atomic"
    },
    {
      "displayed": true,
      "id": "thermal_diagnosis",
      "inputs": [
        "thermal_overview",
        "cpu_freq_overview",
        "thermal_prediction",
        "gpu_power_probe",
        "frequency_drops",
        "high_temp_periods",
        "direct_limit_evidence",
        "root_cause"
      ],
      "name": "热节流诊断",
      "rules": [
        {
          "condition": "root_cause.data[0]?.classification === 'THERMAL_LIMIT_CONFIRMED'",
          "confidence": "high",
          "diagnosis": "已核验热限频：${direct_limit_evidence.data[0].cooling_confirmed_episodes} 段限频区段中有限频写入紧跟在与该 policy 时序关联的内核散热设备升档之后（最大深度 ${direct_limit_evidence.data[0].deepest_depth_pct}%；逐次写入分类 ${direct_limit_evidence.data[0].onset_trigger_mix}）",
          "severity": "warning",
          "suggestions": [
            "用 cpu_frequency_limit_attribution 查看谁触发了限频、限频前的负载归因与异常线程",
            "散热设备与 policy 的对应关系来自档位变更与上限变更的时序配对，不来自设备名；核对触发它的热区阈值"
          ]
        },
        {
          "condition": "root_cause.data[0]?.thermal_throttling_evidence === 'limit_observed_cause_unverified'",
          "confidence": "medium",
          "diagnosis": "观测到 ${direct_limit_evidence.data[0].episode_count} 段限频区段，但没有一次限频写入由关联散热设备施加（分类 ${direct_limit_evidence.data[0].freq_limit_classification}）；限频原因未核验",
          "severity": "info",
          "suggestions": [
            "用 cpu_frequency_limit_attribution 判断是用户态温控守护进程、非热策略限频，还是采集缺少 thermal/cdev_update"
          ]
        },
        {
          "condition": "root_cause.data[0]?.classification === 'DATA_SUSPECT'",
          "confidence": "low",
          "diagnosis": "温度数据可疑或传感器不可直接比较；峰值仅来自通过质量筛选的轨道，不能确定热节流",
          "severity": "warning",
          "suggestions": [
            "检查各轨道 sample_quality、unit_basis 和传感器位置，勿将皮肤温度视为 CPU 结温"
          ]
        },
        {
          "condition": "root_cause.data[0]?.classification === 'THERMAL_DATA_UNAVAILABLE'",
          "confidence": "low",
          "diagnosis": "没有足够可靠的温度数据，热状态不可判定",
          "severity": "info"
        },
        {
          "condition": "root_cause.data[0]?.classification === 'HIGH_TEMP_OBSERVED'",
          "confidence": "medium",
          "diagnosis": "观测到高温 ${root_cause.data[0].peak_temp_c}C；需要持续时间和直接限频证据才能判断热节流",
          "severity": "warning"
        },
        {
          "condition": "root_cause.data[0]?.classification === 'FREQ_INSTABILITY'",
          "confidence": "medium",
          "diagnosis": "观测到 ${root_cause.data[0].severe_drop_count} 次频率下降，负载或空闲 DVFS 均可解释，热原因未核验",
          "severity": "info"
        },
        {
          "condition": "root_cause.data[0]?.classification === 'THERMAL_NORMAL'",
          "confidence": "medium",
          "diagnosis": "有效传感器未见高温；不代表所有 CPU 结温均可观测",
          "severity": "info"
        }
      ],
      "type": "diagnostic"
    },
    {
      "condition": "data_check.data[0]?.has_thermal_data !== 1 && data_check.data[0]?.has_freq_data !== 1 && data_check.data[0]?.has_gpu_freq_data !== 1",
      "displayed": true,
      "id": "no_data_fallback",
      "name": "无温度数据",
      "query_id": "thermal_throttling/no_data_fallback",
      "result_dependencies": [],
      "save_as": "no_data_fallback",
      "type": "atomic"
    }
  ],
  "type": "composite",
  "version": "3.0",
  "workflow": "power-thermal"
}
