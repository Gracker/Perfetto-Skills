{
  "android": {
    "adapters": [
      {
        "id": "kernel_tracepoints",
        "selection": "available events, trace config/setup errors, schema, then rows"
      }
    ],
    "selection_order": [
      "device_capability",
      "trace_config_and_setup_errors",
      "engine_module_and_schema",
      "target_range_row_coverage",
      "api_hint"
    ],
    "signal_patterns": [
      "android_job_scheduler_pending_reasons_track_events",
      "android_job_scheduler_states_track_events"
    ]
  },
  "id": "android_job_scheduler_events",
  "identity": {
    "aliases": [
      "package",
      "process_name",
      "package_name",
      "target_package",
      "app_package",
      "packageName",
      "processName"
    ],
    "minConfidence": 50,
    "policy": "verify_if_present",
    "rewriteTo": "recommended_process_name_param",
    "scope": "process"
  },
  "inputs": [
    {
      "description": "目标包名（可选，精确匹配，含 name:* 子进程）",
      "name": "package",
      "required": false,
      "type": "string"
    },
    {
      "description": "分析起始时间戳(ns)：ATrace 按执行区间相交，等待汇总按任务启动时间筛选；上报等待时长不按窗口裁剪",
      "name": "start_ts",
      "required": false,
      "type": "timestamp"
    },
    {
      "description": "分析结束时间戳(ns)",
      "name": "end_ts",
      "required": false,
      "type": "timestamp"
    }
  ],
  "prerequisites": {
    "modules": [
      "android.job_scheduler",
      "android.job_scheduler_states_track_events"
    ],
    "required_tables": []
  },
  "query_id": null,
  "runtime_status": "executable",
  "schema_version": 1,
  "source": {
    "path": "backend/skills/atomic/android_job_scheduler_events.skill.yaml",
    "sha256": "aa6721a92d941b2fca0139aeba55e46532db1d83720306e4d47b18ac850346bd"
  },
  "steps": [
    {
      "displayed": true,
      "id": "job_events",
      "name": "Job 事件列表",
      "query_id": "android_job_scheduler_events/job_events",
      "result_dependencies": [],
      "type": "atomic"
    },
    {
      "displayed": true,
      "id": "pending_reason_capability",
      "name": "等待原因能力检查",
      "query_id": "android_job_scheduler_events/pending_reason_capability",
      "result_dependencies": [],
      "save_as": "pending_reason_capability",
      "type": "atomic"
    },
    {
      "condition": "pending_reason_capability.data[0]?.status === 'runtime_supported'",
      "displayed": true,
      "id": "pending_reason_data",
      "name": "已完成任务等待原因数据检查",
      "optional": true,
      "query_id": "android_job_scheduler_events/pending_reason_data",
      "result_dependencies": [],
      "save_as": "pending_reason_data",
      "type": "atomic"
    },
    {
      "condition": "pending_reason_data.data[0]?.status === 'available'",
      "displayed": true,
      "id": "pending_reason_summary",
      "name": "已完成任务等待原因汇总",
      "optional": true,
      "query_id": "android_job_scheduler_events/pending_reason_summary",
      "result_dependencies": [],
      "type": "atomic"
    }
  ],
  "type": "atomic",
  "version": "1.1",
  "workflow": "cpu-scheduling"
}
