{
  "android": {
    "adapters": [
      {
        "id": "kernel_tracepoints",
        "selection": "available events, trace config/setup errors, schema, then rows"
      }
    ],
    "selection_order": [
      "device_capability",
      "trace_config_and_setup_errors",
      "engine_module_and_schema",
      "target_range_row_coverage",
      "api_hint"
    ],
    "signal_patterns": []
  },
  "id": "global_trace_sanity_check",
  "identity": {
    "policy": "none"
  },
  "inputs": [
    {
      "description": "分析起始时间戳(ns)，默认 trace_start()",
      "name": "start_ts",
      "required": false,
      "type": "timestamp"
    },
    {
      "description": "分析结束时间戳(ns)，默认 trace_end()",
      "name": "end_ts",
      "required": false,
      "type": "timestamp"
    },
    {
      "default": 20,
      "description": "每个明细表最大返回行数",
      "name": "max_rows",
      "required": false,
      "type": "integer"
    }
  ],
  "prerequisites": {
    "modules": [
      "sched.thread_level_parallelism"
    ],
    "required_tables": [
      "slice",
      "thread_state",
      "sched_slice"
    ]
  },
  "query_id": null,
  "runtime_status": "executable",
  "schema_version": 1,
  "source": {
    "commit": "eec8bff767eb3277f1f0dd106d0d7a0cfdab2dfc",
    "path": "backend/skills/composite/global_trace_sanity_check.skill.yaml",
    "sha256": "40eb466a75eceb554305c30faaaae38f2741a7efda2d7f091bd40975d42ef575"
  },
  "steps": [
    {
      "id": "trace_window",
      "name": "Trace 时间窗",
      "query_id": "global_trace_sanity_check/trace_window",
      "result_dependencies": [],
      "save_as": "trace_window",
      "type": "atomic"
    },
    {
      "id": "top_long_slices",
      "name": "最长 Slice",
      "params": {
        "end_ts": "${end_ts}",
        "max_rows": "${max_rows}",
        "start_ts": "${start_ts}"
      },
      "save_as": "top_long_slices",
      "skill": "longest_process_slices",
      "type": "skill"
    },
    {
      "id": "top_d_state_threads",
      "name": "D 状态线程",
      "query_id": "global_trace_sanity_check/top_d_state_threads",
      "result_dependencies": [],
      "save_as": "top_d_state_threads",
      "type": "atomic"
    },
    {
      "id": "top_runnable_waits",
      "name": "Runnable 等待线程",
      "query_id": "global_trace_sanity_check/top_runnable_waits",
      "result_dependencies": [],
      "save_as": "top_runnable_waits",
      "type": "atomic"
    },
    {
      "id": "runqueue_pressure",
      "name": "Runqueue 压力",
      "query_id": "global_trace_sanity_check/runqueue_pressure",
      "result_dependencies": [],
      "save_as": "runqueue_pressure",
      "type": "atomic"
    },
    {
      "id": "top_cpu_processes",
      "name": "CPU 热点进程",
      "query_id": "global_trace_sanity_check/top_cpu_processes",
      "result_dependencies": [],
      "save_as": "top_cpu_processes",
      "type": "atomic"
    }
  ],
  "type": "composite",
  "version": "1.0",
  "workflow": "trace-overview"
}
