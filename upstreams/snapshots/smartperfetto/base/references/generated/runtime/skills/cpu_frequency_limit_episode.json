{
  "android": {
    "adapters": [
      {
        "id": "kernel_tracepoints",
        "selection": "available events, trace config/setup errors, schema, then rows"
      }
    ],
    "selection_order": [
      "device_capability",
      "trace_config_and_setup_errors",
      "engine_module_and_schema",
      "target_range_row_coverage",
      "api_hint"
    ],
    "signal_patterns": []
  },
  "id": "cpu_frequency_limit_episode",
  "identity": {
    "policy": "none"
  },
  "inputs": [
    {
      "description": "区段标识（由上层传入）",
      "name": "episode_id",
      "required": false,
      "type": "string"
    },
    {
      "description": "区段开始时间戳(ns)",
      "name": "episode_start_ts",
      "required": true,
      "type": "timestamp"
    },
    {
      "description": "区段结束时间戳(ns)",
      "name": "episode_end_ts",
      "required": true,
      "type": "timestamp"
    },
    {
      "description": "cpufreq policy 首核编号",
      "name": "policy_cpu",
      "required": false,
      "type": "number"
    },
    {
      "description": "核心类型（可能为 unknown）",
      "name": "core_type",
      "required": false,
      "type": "string"
    },
    {
      "default": 0,
      "description": "区段首个样本即轨道首样本时为 1，表示起点在数据之外、不可知",
      "name": "starts_at_data_start",
      "required": false,
      "type": "number"
    },
    {
      "default": 10000,
      "description": "限频前回溯窗口长度(ms)",
      "name": "lookback_ms",
      "required": false,
      "type": "number"
    },
    {
      "default": 2000,
      "description": "限频时刻前后的归因窗口半径(ms)",
      "name": "who_window_ms",
      "required": false,
      "type": "number"
    },
    {
      "default": 50,
      "description": "散热设备档位变更与限频时刻的重合容差(ms)；重合才视为该次限频由内核热控直接施加",
      "name": "cooling_coincidence_ms",
      "required": false,
      "type": "number"
    },
    {
      "description": "目标包名/进程名",
      "name": "package",
      "required": false,
      "type": "string"
    },
    {
      "description": "目标进程名别名",
      "name": "process_name",
      "required": false,
      "type": "string"
    },
    {
      "default": 30,
      "description": "负载/异常线程返回上限",
      "name": "top_n",
      "required": false,
      "type": "number"
    },
    {
      "default": 80,
      "description": "异常线程：持续占用阈值(%)",
      "name": "sustained_pct",
      "required": false,
      "type": "number"
    },
    {
      "default": 200,
      "description": "异常线程：疑似空转平均片长上限(us)",
      "name": "spin_avg_slice_us",
      "required": false,
      "type": "number"
    },
    {
      "default": 2000,
      "description": "异常线程：疑似空转每秒片数下限",
      "name": "spin_switches_per_s",
      "required": false,
      "type": "number"
    },
    {
      "default": 500,
      "description": "异常线程：唤醒风暴阈值(次/秒)",
      "name": "waker_per_s",
      "required": false,
      "type": "number"
    },
    {
      "default": 10,
      "description": "异常线程：内核守护重载阈值(%)",
      "name": "kernel_daemon_share_pct",
      "required": false,
      "type": "number"
    }
  ],
  "prerequisites": {
    "modules": [
      "linux.cpu.frequency",
      "android.process_metadata"
    ],
    "required_tables": [
      "counter",
      "counter_track",
      "sched_slice"
    ]
  },
  "process_scope": {
    "role": "global_context"
  },
  "query_id": null,
  "runtime_status": "executable",
  "schema_version": 1,
  "source": {
    "commit": "98eb78f5af52822edd880b120aa27e2f5f41c6df",
    "path": "backend/skills/composite/cpu_frequency_limit_episode.skill.yaml",
    "sha256": "b02b4e752ee6809352b02fbf8267c6cd3900768a842fe46ba886cfc61a79bbbd"
  },
  "steps": [
    {
      "id": "episode_windows",
      "name": "区段分析窗口",
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "cpu_frequency_limit_episode/episode_windows",
      "result_dependencies": [],
      "save_as": "episode_windows",
      "type": "atomic"
    },
    {
      "id": "who_cooling",
      "name": "归因窗口内散热设备活动",
      "on_empty": "归因窗口内没有内核散热设备事件。该平台可能没有 cdev_update，或热控由用户态守护进程直接写 sysfs 完成。",
      "optional": true,
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "cpu_frequency_limit_episode/who_cooling",
      "result_dependencies": [
        "episode_windows"
      ],
      "save_as": "who_cooling",
      "type": "atomic"
    },
    {
      "id": "who_daemon",
      "name": "归因窗口内温控/性能策略守护进程活动",
      "on_empty": "归因窗口内没有名字匹配温控/性能策略签名的线程在运行。",
      "optional": true,
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "cpu_frequency_limit_episode/who_daemon",
      "result_dependencies": [
        "episode_windows"
      ],
      "save_as": "who_daemon",
      "type": "atomic"
    },
    {
      "id": "temperature_context",
      "name": "限频前温度上下文",
      "on_empty": "回溯窗口内没有温度采样。部分平台温度上报非常稀疏（每分钟数次），窗口内无样本不代表温度未变化。",
      "optional": true,
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "cpu_frequency_limit_episode/temperature_context",
      "result_dependencies": [
        "episode_windows"
      ],
      "save_as": "temperature_context",
      "type": "atomic"
    },
    {
      "id": "before_workload",
      "name": "限频前负载归因",
      "optional": true,
      "params": {
        "end_ts": "${episode_windows.data?.[0]?.before_end_ts}",
        "package": "${package || ''}",
        "process_name": "${process_name || ''}",
        "start_ts": "${episode_windows.data?.[0]?.before_start_ts}",
        "top_n": "${top_n|30}"
      },
      "save_as": "before_workload",
      "skill": "cpu_workload_attribution_in_range",
      "type": "skill"
    },
    {
      "id": "before_anomalies",
      "name": "限频前异常线程",
      "optional": true,
      "params": {
        "end_ts": "${episode_windows.data?.[0]?.before_end_ts}",
        "kernel_daemon_share_pct": "${kernel_daemon_share_pct|10}",
        "package": "${package || ''}",
        "process_name": "${process_name || ''}",
        "spin_avg_slice_us": "${spin_avg_slice_us|200}",
        "spin_switches_per_s": "${spin_switches_per_s|2000}",
        "start_ts": "${episode_windows.data?.[0]?.before_start_ts}",
        "sustained_pct": "${sustained_pct|80}",
        "top_n": "${top_n|30}",
        "waker_per_s": "${waker_per_s|500}"
      },
      "save_as": "before_anomalies",
      "skill": "cpu_anomalous_threads_in_range",
      "type": "skill"
    },
    {
      "id": "non_cpu_heat_context",
      "name": "限频前非 CPU 热源上下文",
      "on_empty": "回溯窗口内没有观测到非 CPU 热源相关的计数器或进程活动。",
      "optional": true,
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "cpu_frequency_limit_episode/non_cpu_heat_context",
      "result_dependencies": [
        "episode_windows"
      ],
      "save_as": "non_cpu_heat_context",
      "type": "atomic"
    },
    {
      "id": "who_verdict",
      "name": "触发方判定",
      "process_scope": {
        "role": "global_context"
      },
      "query_id": "cpu_frequency_limit_episode/who_verdict",
      "result_dependencies": [
        "episode_windows"
      ],
      "save_as": "who_verdict",
      "type": "atomic"
    }
  ],
  "type": "composite",
  "version": "1.0",
  "workflow": "power-thermal"
}
