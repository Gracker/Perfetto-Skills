  "id": "anr_main_thread_blocking",
  "identity": {
    "policy": "none"
  },
  "inputs": [
    {
      "default": "",
      "description": "目标进程名；省略时仅通过 wakeup_chain 发现各应用主线程最长等待候选，不判定 ANR",
      "name": "process_name",
      "required": false,
      "type": "string"
    },
    {
      "description": "分析起始时间戳(ns)",
      "name": "start_ts",
      "required": false,
      "type": "timestamp"
    },
    {
      "description": "分析结束时间戳(ns)",
      "name": "end_ts",
      "required": false,
      "type": "timestamp"
    },
    {
      "description": "ANR 事件时间戳(ns)，用于自动计算分析窗口",
      "name": "anr_ts",
      "required": false,
      "type": "timestamp"
    },
    {
      "description": "无目标发现模式的最短单段等待毫秒数，默认 3000",
      "name": "min_wait_ms",
      "required": false,
      "type": "number"
    },
    {
      "description": "无目标发现模式的候选条数，默认 20，上限 100",
      "name": "top_n",
      "required": false,
      "type": "number"
    },
    {
      "description": "无目标发现模式的分页偏移，默认 0",
      "name": "offset",
      "required": false,
      "type": "number"
    }
  ],
  "prerequisites": {
